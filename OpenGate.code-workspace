{
  "folders": [
    {
      "path": ".",
      "name": "OpenGate (root)"
    },
    {
      "path": "esp32/opengate",
      "name": "ESP32 Firmware"
    },
    {
      "path": "android",
      "name": "Android App"
    },
    {
      "path": "local",
      "name": "Local Config"
    }
  ],

  "settings": {
    "editor.formatOnSave": true,
    "editor.rulers": [80, 120],
    "files.trimFinalNewlines": true,
    "files.insertFinalNewline": true,

    "files.exclude": {
      "**/.pio": true,
      "**/.git": true,
      "**/build": true,
      "**/.gradle": true,
      "**/node_modules": true,
      "**/__pycache__": true
    },

    "search.exclude": {
      "**/.pio": true,
      "**/.git": true,
      "**/build": true,
      "**/.gradle": true,
      "**/node_modules": true,
      "**/.vscode": true
    },

    "[cpp]": {
      "editor.defaultFormatter": "ms-vscode.cpptools",
      "editor.formatOnSave": true
    },
    "[c]": {
      "editor.defaultFormatter": "ms-vscode.cpptools"
    },

    "C_Cpp.default.includePath": [
      "${workspaceFolder:ESP32 Firmware}/src",
      "${workspaceFolder:ESP32 Firmware}/lib",
      "${workspaceFolder:ESP32 Firmware}/.pio/libdeps/esp32dev"
    ],

    "platformio-ide.autoRebuild": false
  },

  "extensions": {
    "recommendations": [
      "platformio.platformio-ide",
      "ms-vscode.cpptools",
      "ms-vscode.cpptools-extension-pack",
      "ms-vscode-remote.remote-ssh",
      "GitHub.copilot"
    ]
  },

  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "PlatformIO: Build ESP32",
        "type": "shell",
        "command": "pio",
        "args": ["run", "-e", "esp32dev"],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "options": {
          "cwd": "${workspaceFolder:ESP32 Firmware}"
        },
        "problemMatcher": []
      },
      {
        "label": "PlatformIO: Upload to ESP32",
        "type": "shell",
        "command": "pio",
        "args": ["run", "-e", "esp32dev", "-t", "upload"],
        "group": {
          "kind": "build"
        },
        "options": {
          "cwd": "${workspaceFolder:ESP32 Firmware}"
        },
        "problemMatcher": []
      },
      {
        "label": "PlatformIO: Monitor Serial",
        "type": "shell",
        "command": "pio",
        "args": ["device", "monitor", "-e", "esp32dev"],
        "group": {
          "kind": "test"
        },
        "options": {
          "cwd": "${workspaceFolder:ESP32 Firmware}"
        },
        "problemMatcher": []
      },
      {
        "label": "PlatformIO: Clean Build",
        "type": "shell",
        "command": "pio",
        "args": ["run", "-e", "esp32dev", "-t", "clean"],
        "group": {
          "kind": "build"
        },
        "options": {
          "cwd": "${workspaceFolder:ESP32 Firmware}"
        },
        "problemMatcher": []
      }
    ]
  }
}
