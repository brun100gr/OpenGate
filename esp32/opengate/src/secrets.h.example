/*
 * Secret configuration TEMPLATE.
 *
 * Copy this file to secrets.h (same folder), then fill in the real values.
 * secrets.h is gitignored so your credentials never reach the repository.
 *
 * Switch between TEST and PRODUCTION by changing ENVIRONMENT below.
 */
#pragma once

// ============ ENVIRONMENT SWITCH ============
#define ENVIRONMENT_TEST
// #define ENVIRONMENT_PROD
// ===========================================

const char* WIFI_SSID     = "YOUR_SSID";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";
const int WIFI_CHANNEL = -1;  // set to your WiFi channel or -1 if unknown
const char* TELEGRAM_BOT_TOKEN = "YOUR_TELEGRAM_BOT_TOKEN";
const long TELEGRAM_CHAT_ID = 0;  // Your Telegram chat ID

// Test broker credentials
const char* MQTT_HOST_TEST     = "test-broker.s1.eu.hivemq.cloud";
const uint16_t MQTT_PORT_TEST  = 8883;
const char* MQTT_USER_TEST     = "opengate-esp32_test";
const char* MQTT_PASSWORD_TEST = "TEST_PASSWORD_HERE";

// Production broker credentials
const char* MQTT_HOST_PROD     = "prod-broker.s1.eu.hivemq.cloud";
const uint16_t MQTT_PORT_PROD  = 8883;
const char* MQTT_USER_PROD     = "opengate-esp32";
const char* MQTT_PASSWORD_PROD = "PROD_PASSWORD_HERE";

// Active broker (selected by ENVIRONMENT_* above)
#ifdef ENVIRONMENT_TEST
  const char* MQTT_HOST     = MQTT_HOST_TEST;
  const uint16_t MQTT_PORT  = MQTT_PORT_TEST;
  const char* MQTT_USER     = MQTT_USER_TEST;
  const char* MQTT_PASSWORD = MQTT_PASSWORD_TEST;
#else
  const char* MQTT_HOST     = MQTT_HOST_PROD;
  const uint16_t MQTT_PORT  = MQTT_PORT_PROD;
  const char* MQTT_USER     = MQTT_USER_PROD;
  const char* MQTT_PASSWORD = MQTT_PASSWORD_PROD;
#endif

// Gate position: the centre of the geofence the phone position is compared
// against. The sketch opens the gate once the filtered position comes within
// GEOFENCE_RADIUS_M of this point. Your home coordinates are as private as a
// password, which is why they live here and not in the sketch.
const double GATE_LATITUDE  = 45.123456;
const double GATE_LONGITUDE = 9.123456;
