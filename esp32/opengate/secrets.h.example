/*
 * Secret configuration TEMPLATE.
 *
 * Copy this file to secrets.h (same folder), then fill in the real values.
 * secrets.h is gitignored so your credentials never reach the repository.
 */
#pragma once

const char* WIFI_SSID     = "YOUR_SSID";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

const char* MQTT_HOST     = "XXXXXXXX.s1.eu.hivemq.cloud"; // your HiveMQ cluster host
const uint16_t MQTT_PORT  = 8883;                          // TLS port
const char* MQTT_USER     = "opengate-esp32";              // credentials created in HiveMQ
const char* MQTT_PASSWORD = "CHANGE_ME";

// Broker root CA (for HiveMQ Cloud: Let's Encrypt "ISRG Root X1").
// Paste the PEM certificate here — see README, "TLS certificate" section.
// If you leave the placeholder, the sketch falls back to setInsecure():
// the connection is encrypted but the server identity is NOT verified
// (vulnerable to MITM).
const char* ROOT_CA = R"EOF(
PASTE_THE_CERTIFICATE_HERE
)EOF";
